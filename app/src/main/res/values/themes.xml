<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NewsApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF090B10</item>
        <item name="android:statusBarColor">#FF0E131E</item>
        <item name="android:navigationBarColor">#FF0E131E</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash Screen API (androidx.core:core-splashscreen) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background_color</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.NewsApp</item>
    </style>
</resources>
